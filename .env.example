# Copie para .env e preencha a chave. Detalhes em docs/desenvolvimento.md.

# Um endpoint compatível com a API de chat completions da OpenAI.
MODEL_PROVIDER_BASE_URL=https://ai-gateway.vercel.sh/v1
MODEL_PROVIDER_API_KEY=

# Os serviços do compose.yaml. Use 127.0.0.1, não localhost (no Windows, localhost vai primeiro ao IPv6).
DATABASE_URL=postgresql://graham:graham@127.0.0.1:5432/graham?connect_timeout=10
REDIS_URL=redis://127.0.0.1:6379/0
PUBLIC_URL=http://127.0.0.1:8000

# Traces opcionais na LangSmith (plano gratuito, sem cartão: até 5.000 por mês).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=graham
